# BASTION configuration
# See https://github.com/cypwin/bastion for full reference.

ollama:
  host: "127.0.0.1"
  port: 11435

server:
  host: "127.0.0.1"
  port: 11434
  trusted_hosts: ["localhost", "127.0.0.1", "host.docker.internal"]  # DNS-rebinding guard: пропускает только эти Host-заголовки

gpu:
  total_vram_gb: 8    # явное значение: auto-detect не сработал в user-сервисе (бюджет=0 -> 504)
  headroom_gb: 0.9    # только для max_vram_gb в /broker/status; на допуск НЕ влияет
  hardware_margin_gb: 0.9  # реальный бюджет допуска: 8192-921=7270MB (дефолт 2.0 давал 6144)
  max_temperature_c: 83

scheduler:
  cooldown_seconds: 2.0
  max_queue_size: 512

# vram_gb — замеренный runtime-VRAM (size_vram из /api/ps), а не размер файла:
# завышение запирает модель в очереди по nvidia-smi backstop, занижение рискует OOM.
models:
  "qwen3.5:9b":
    vram_gb: 5.5        # size_vram 5602MB при num_ctx 24576; 5527MB при 16384
    default_num_ctx: 24576  # файлы до ~24k токенов целиком; 684MB весов уходит в CPU
    tags: ["general"]
